section

/-!
# Countable calibrated C1,1 cores carrying actual complete geodesic families

Refine each compact trimmed contact core by finitely many half-radius closed balls.
Each refined core lies in an open coordinate ball carrying the complete original
geodesics generated by the actual derivative of the same C1,1 extension. The original
potential, derivative, positive calibrated reach, compact partner carriers and exact
cover of the entire calibrated interior are all retained.
-/

open Set Filter Metric Manifold Bundle
open scoped Topology ContDiff NNReal

noncomputable section
universe u v
namespace OTSelector.Geometry.ContinuousFinslerNorm.IsSmoothStronglyConvex

variable {E : Type u} {M : Type v} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [TopologicalSpace M] [ChartedSpace E M]
  [IsManifold 𝓘(ℝ, E) ∞ M] [T2Space M] [PreconnectedSpace M]
  {F : ContinuousFinslerNorm E M}

theorem exists_C11_core_family_ball (hF : F.IsSmoothStronglyConvex)
    (hcomplete : @CompleteSpace M F.metricSpace.toUniformSpace) (old : M)
    {K : Set E} (hK : K ⊆ (extChartAt 𝓘(ℝ, E) old).target)
    {f : M → ℝ} (hf : let _instFamilyBallLip : MetricSpace M := F.metricSpace
      LipschitzWith 1 f)
    {G : E → ℝ} {L : ℝ≥0} (hG : ContDiff ℝ 1 G)
    (hLip : LipschitzWith L (fderiv ℝ G))
    (hmatch : EqOn (fderiv ℝ G)
      (fderiv ℝ (f ∘ (extChartAt 𝓘(ℝ, E) old).symm)) K)
    {δ : ℝ} (hδ : 0 < δ)
    (hpartners : let _instFamilyBallPartners : MetricSpace M := F.metricSpace
      ∀ x ∈ K, ∃ a b : M,
        dist a ((extChartAt 𝓘(ℝ, E) old).symm x) = δ ∧
        f ((extChartAt 𝓘(ℝ, E) old).symm x) - f a = δ ∧
        dist ((extChartAt 𝓘(ℝ, E) old).symm x) b = δ ∧
        f b - f ((extChartAt 𝓘(ℝ, E) old).symm x) = δ)
    {x₀ : E} (hx₀ : x₀ ∈ K) :
    ∃ (r : ℝ) (Γ : E → ℝ → M), 0 < r ∧
      closedBall x₀ r ⊆ (extChartAt 𝓘(ℝ, E) old).target ∧
      ∀ x ∈ closedBall x₀ r,
        Γ x 0 = (extChartAt 𝓘(ℝ, E) old).symm x ∧
        F.IsEulerLagrangeOn (Γ x) univ ∧
        ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E) ∞ (Γ x) ∧
        F.chartMomentumFamily old Γ (x, 0) = (x, fderiv ℝ G x) := by
  let _instFamilyBallMetric : MetricSpace M := F.metricSpace
  have hd : ∀ x ∈ K, MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, ℝ) f
      ((extChartAt 𝓘(ℝ, E) old).symm x) := by
    intro x hx
    obtain ⟨a, b, hax, ha, hxb, hb⟩ := hpartners x hx
    apply hF.mdifferentiableAt_of_mem_calibratedInterior hcomplete hf
    refine ⟨⟨a, ?_, ha.trans hax.symm⟩, ⟨b, ?_, hb.trans hxb.symm⟩⟩
    · exact dist_pos.mp (hax.symm ▸ hδ)
    · exact dist_pos.mp (hxb.symm ▸ hδ)
  have hforward : ∀ x ∈ K, ∃ b : M,
      (extChartAt 𝓘(ℝ, E) old).symm x ≠ b ∧
      f b - f ((extChartAt 𝓘(ℝ, E) old).symm x) =
        dist ((extChartAt 𝓘(ℝ, E) old).symm x) b := by
    intro x hx
    obtain ⟨a, b, _, _, hxb, hb⟩ := hpartners x hx
    exact ⟨b, dist_pos.mp (hxb.symm ▸ hδ), hb.trans hxb.symm⟩
  obtain ⟨v₀, hv₀, hp₀, _⟩ :=
    hF.chart_unit_legendre_on_of_calibrated_endpoints hcomplete old hK hf hd hforward x₀ hx₀
  obtain ⟨r, _, Γ, hr, _, hball, hinit, _, _⟩ :=
    hF.exists_C11_short_geodesic_translation hcomplete old hG hLip hv₀
      (hp₀.trans (hmatch hx₀).symm)
  exact ⟨r, Γ, hr, hball, hinit⟩

/-- The whole actual calibrated interior has an exact countable compact C1,1 cover
retaining uniform positive two-sided reach. Every core lies in a constructed open
coordinate domain carrying complete original geodesics with the actual extension
covector as initial momentum. No family, initial state or additional measure data
are supplied. -/
theorem exists_countable_calibrated_C11_family_cover (hF : F.IsSmoothStronglyConvex)
    (hcomplete : @CompleteSpace M F.metricSpace.toUniformSpace)
    {f : M → ℝ} (hf : let _instFamilyCoverLip : MetricSpace M := F.metricSpace
      LipschitzWith 1 f) :
    let _instFamilyCoverMetric : MetricSpace M := F.metricSpace
    ∃ ι : Type (max u v), Countable ι ∧
      ∃ (old : ι → M) (K U : ι → Set E) (G : ι → E → ℝ) (L : ι → ℝ≥0)
          (δ : ι → ℝ) (B : ι → Set M) (Γ : ι → E → ℝ → M),
        (∀ i, IsCompact (K i) ∧ K i ⊆ (extChartAt 𝓘(ℝ, E) (old i)).target ∧
          ContDiff ℝ 1 (G i) ∧ HasCompactSupport (G i) ∧
          LipschitzWith (L i) (fderiv ℝ (G i)) ∧
          EqOn (G i) (f ∘ (extChartAt 𝓘(ℝ, E) (old i)).symm) (K i) ∧
          EqOn (fderiv ℝ (G i))
            (fderiv ℝ (f ∘ (extChartAt 𝓘(ℝ, E) (old i)).symm)) (K i) ∧
          ∀ x ∈ K i, HasFDerivAt (f ∘ (extChartAt 𝓘(ℝ, E) (old i)).symm)
            (fderiv ℝ (G i) x) x) ∧
        (⋃ i, (extChartAt 𝓘(ℝ, E) (old i)).symm '' K i) =
          OTSelector.Geometry.calibratedInterior f ∧
        (∀ i, 0 < δ i ∧ IsCompact (B i) ∧
          ∀ x ∈ K i, ∃ a ∈ B i, ∃ b ∈ B i,
            dist a ((extChartAt 𝓘(ℝ, E) (old i)).symm x) = δ i ∧
            f ((extChartAt 𝓘(ℝ, E) (old i)).symm x) - f a = δ i ∧
            dist ((extChartAt 𝓘(ℝ, E) (old i)).symm x) b = δ i ∧
            f b - f ((extChartAt 𝓘(ℝ, E) (old i)).symm x) = δ i) ∧
        ∀ i, IsOpen (U i) ∧ K i ⊆ U i ∧
          U i ⊆ (extChartAt 𝓘(ℝ, E) (old i)).target ∧
          ∀ x ∈ U i,
            Γ i x 0 = (extChartAt 𝓘(ℝ, E) (old i)).symm x ∧
            F.IsEulerLagrangeOn (Γ i x) univ ∧
            ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E) ∞ (Γ i x) ∧
            F.chartMomentumFamily (old i) (Γ i) (x, 0) = (x, fderiv ℝ (G i) x) := by
  classical
  let _instFamilyCoverMetric : MetricSpace M := F.metricSpace
  obtain ⟨ι, hcount, old, K, G, L, δ, B, hdata, hcover, hreach⟩ :=
    hF.exists_countable_trimmed_calibrated_C11_cover hcomplete hf
  let _instFamilyCoverCountable : Countable ι := hcount
  have hlocal (i : ι) (x : K i) :=
    hF.exists_C11_core_family_ball hcomplete (old i) (hdata i).2.1 hf
      (hdata i).2.2.1 (hdata i).2.2.2.2.1 (hdata i).2.2.2.2.2.2.1
      (hreach i).1 (by
        dsimp only
        intro z hz
        obtain ⟨a, _, b, _, ha, hfa, hb, hfb⟩ := (hreach i).2.2 z hz
        exact ⟨a, b, ha, hfa, hb, hfb⟩) x.property
  choose r Γ hr hball hinit using hlocal
  have hfinite (i : ι) := (hdata i).1.elim_finite_subcover
    (fun x : K i ↦ ball (x : E) (r i x / 2)) (fun _ ↦ isOpen_ball)
    (by
      intro z hz
      exact mem_iUnion.mpr ⟨⟨z, hz⟩, mem_ball_self (half_pos (hr i ⟨z, hz⟩))⟩)
  choose J hJ using hfinite
  let κ := Σ i : ι, {x : K i // x ∈ J i}
  let C : κ → Set E := fun p ↦ K p.1 ∩ closedBall p.2.val.val (r p.1 p.2.val / 2)
  let U : κ → Set E := fun p ↦ ball p.2.val.val (r p.1 p.2.val)
  refine ⟨κ, inferInstance, (fun p ↦ old p.1), C, U, (fun p ↦ G p.1),
    (fun p ↦ L p.1), (fun p ↦ δ p.1), (fun p ↦ B p.1),
    (fun p ↦ Γ p.1 p.2.val), ?_, ?_, ?_, ?_⟩
  · intro p
    obtain ⟨hK, htarget, hG, hsupp, hLip, hval, hder, hactual⟩ := hdata p.1
    exact ⟨hK.inter_right isClosed_closedBall, fun x hx ↦ htarget hx.1,
      hG, hsupp, hLip, hval.mono inter_subset_left, hder.mono inter_subset_left,
      fun x hx ↦ hactual x hx.1⟩
  · apply Subset.antisymm
    · intro x hx
      obtain ⟨p, z, hz, rfl⟩ := mem_iUnion.mp hx
      rw [← hcover]
      exact mem_iUnion.mpr ⟨p.1, z, hz.1, rfl⟩
    · intro x hx
      rw [← hcover] at hx
      obtain ⟨i, z, hz, hzx⟩ := mem_iUnion.mp hx
      obtain ⟨j, hj, hzj⟩ := mem_iUnion₂.mp (hJ i hz)
      exact mem_iUnion.mpr ⟨⟨i, ⟨j, hj⟩⟩, z, ⟨hz, ball_subset_closedBall hzj⟩, hzx⟩
  · intro p
    exact ⟨(hreach p.1).1, (hreach p.1).2.1,
      fun x hx ↦ (hreach p.1).2.2 x hx.1⟩
  · intro p
    refine ⟨isOpen_ball, ?_, ?_, ?_⟩
    · exact fun x hx ↦ closedBall_subset_ball (half_lt_self (hr p.1 p.2.val)) hx.2
    · exact fun x hx ↦ hball p.1 p.2.val (ball_subset_closedBall hx)
    · exact fun x hx ↦ hinit p.1 p.2.val x (ball_subset_closedBall hx)

end OTSelector.Geometry.ContinuousFinslerNorm.IsSmoothStronglyConvex

end
end
