section

/-!
# Exact Haar change of variables for original calibrated translations

The actual complete family generated by the original C1,1 potential covectors
retains its calibration, original clock and two-sided volume bounds. Its short
coordinate translations now have exact change-of-variables identities on every
measurable subset of the open parameter ball. Rademacher exceptions and their
images are removed inside the generic Lipschitz theorem; no replacement flow,
everywhere differentiability or positive population density is assumed.
-/

open Set Filter Metric Manifold Bundle MeasureTheory MeasureTheory.Measure
open scoped Topology ContDiff NNReal ENNReal

noncomputable section
namespace OTSelector.Geometry.ContinuousFinslerNorm.IsSmoothStronglyConvex

variable {E M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  [TopologicalSpace M] [ChartedSpace E M] [IsManifold 𝓘(ℝ, E) ∞ M]
  [T2Space M] [PreconnectedSpace M] {F : ContinuousFinslerNorm E M}

/-- The same original calibrated family has exact coordinate volume transfer on all
measurable subpieces of its open ball, for every legal short time. -/
theorem exists_C11_calibrated_exact_volume_translation (hF : F.IsSmoothStronglyConvex)
    (hcomplete : @CompleteSpace M F.metricSpace.toUniformSpace) (old : M)
    (m : Measure E) [IsAddHaarMeasure m]
    {K : Set E} (hK : K ⊆ (extChartAt 𝓘(ℝ, E) old).target)
    {u : M → ℝ} (hu : let _instVolumeTranslationLip : MetricSpace M := F.metricSpace
      LipschitzWith 1 u)
    {G : E → ℝ} {L : ℝ≥0} (hG : ContDiff ℝ 1 G)
    (hLip : LipschitzWith L (fderiv ℝ G))
    (hmatch : EqOn (fderiv ℝ G)
      (fderiv ℝ (u ∘ (extChartAt 𝓘(ℝ, E) old).symm)) K)
    {δ : ℝ} (hδ : 0 < δ)
    (hpartners : let _instVolumeTranslationPartners : MetricSpace M := F.metricSpace
      ∀ x ∈ K, ∃ a b : M,
        dist a ((extChartAt 𝓘(ℝ, E) old).symm x) = δ ∧
        u ((extChartAt 𝓘(ℝ, E) old).symm x) - u a = δ ∧
        dist ((extChartAt 𝓘(ℝ, E) old).symm x) b = δ ∧
        u b - u ((extChartAt 𝓘(ℝ, E) old).symm x) = δ)
    {x₀ : E} (hx₀ : x₀ ∈ K) :
    let _instVolumeTranslationResult : MetricSpace M := F.metricSpace
    ∃ (r τ : ℝ) (Γ : E → ℝ → M), 0 < r ∧ 0 < τ ∧ τ ≤ δ / 2 ∧
      closedBall x₀ r ⊆ (extChartAt 𝓘(ℝ, E) old).target ∧
      (∀ x ∈ closedBall x₀ r,
        Γ x 0 = (extChartAt 𝓘(ℝ, E) old).symm x ∧
        F.IsEulerLagrangeOn (Γ x) univ ∧
        ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E) ∞ (Γ x) ∧
        F.chartMomentumFamily old Γ (x, 0) = (x, fderiv ℝ G x)) ∧
      ContinuousOn (fun q : ℝ × E ↦ extChartAt 𝓘(ℝ, E) old (Γ q.2 q.1))
        (Icc (-τ) τ ×ˢ closedBall x₀ r) ∧
      (∀ t ∈ Icc (-τ) τ,
        MapsTo (fun x ↦ Γ x t) (closedBall x₀ r) (extChartAt 𝓘(ℝ, E) old).source ∧
        LipschitzOnWith (1 / 2) (fun x ↦ extChartAt 𝓘(ℝ, E) old (Γ x t) - x)
          (closedBall x₀ r) ∧
        ∀ B ⊆ closedBall x₀ r,
          m ((fun x ↦ extChartAt 𝓘(ℝ, E) old (Γ x t)) '' B) ≤
            (3 / 2 : ℝ≥0∞) ^ Module.finrank ℝ E * m B ∧
          m B ≤ (2 : ℝ≥0∞) ^ Module.finrank ℝ E *
            m ((fun x ↦ extChartAt 𝓘(ℝ, E) old (Γ x t)) '' B)) ∧
      (∀ t ∈ Icc (-τ) τ, ∀ s : Set E, MeasurableSet s → s ⊆ ball x₀ r →
        Measure.map (fun x ↦ extChartAt 𝓘(ℝ, E) old (Γ x t))
          ((m.restrict s).withDensity (fun x ↦ ENNReal.ofReal
            |(fderiv ℝ (fun y ↦ extChartAt 𝓘(ℝ, E) old (Γ y t)) x).det|)) =
          m.restrict ((fun x ↦ extChartAt 𝓘(ℝ, E) old (Γ x t)) '' s) ∧
        ∀ g : E → ℝ≥0∞,
          (∫⁻ y in (fun x ↦ extChartAt 𝓘(ℝ, E) old (Γ x t)) '' s, g y ∂m) =
            ∫⁻ x in s, ENNReal.ofReal
              |(fderiv ℝ (fun y ↦ extChartAt 𝓘(ℝ, E) old (Γ y t)) x).det| *
              g (extChartAt 𝓘(ℝ, E) old (Γ x t)) ∂m) ∧
      ∀ x ∈ K ∩ closedBall x₀ r,
        (∀ t : ℝ, F.toFun (tangentMap 𝓘(ℝ, ℝ) 𝓘(ℝ, E) (Γ x) ⟨t, (1 : ℝ)⟩) = 1) ∧
        Isometry (fun t : Icc (-δ) δ ↦ Γ x t) ∧
        (∀ t ∈ Icc (-δ) δ,
          u (Γ x t) = u ((extChartAt 𝓘(ℝ, E) old).symm x) + t ∧
          |u (Γ x t) - u ((extChartAt 𝓘(ℝ, E) old).symm x)| =
            dist ((extChartAt 𝓘(ℝ, E) old).symm x) (Γ x t)) ∧
        ∀ t ∈ Icc (-τ) τ,
          Γ x t ∈ OTSelector.Geometry.calibratedInterior u ∧
          Γ x t ∈ F.potentialRegularDomain u := by
  let _instExactVolumeMetric : MetricSpace M := F.metricSpace
  obtain ⟨r, τ, Γ, hr, hτ, hτδ, hball, hinit, hcont, hflow, hcore⟩ :=
    hF.exists_C11_calibrated_volume_translation hcomplete old m hK hu hG hLip
      hmatch hδ hpartners hx₀
  refine ⟨r, τ, Γ, hr, hτ, hτδ, hball, hinit, hcont, hflow, ?_, hcore⟩
  intro t ht s hs hsball
  have hdisp := (hflow t ht).2.1.mono ball_subset_closedBall
  have hT := lipschitzOnWith_of_half_lipschitz_displacement hdisp
  have hA := antilipschitzWith_of_half_lipschitz_displacement hdisp
  have hinj := injOn_iff_injective.mpr hA.injective
  exact ⟨map_withDensity_abs_det_fderiv_of_lipschitzOnWith m isOpen_ball hT hinj hs hsball,
    fun g ↦ lintegral_image_abs_det_fderiv_of_lipschitzOnWith
      m isOpen_ball hT hinj hs hsball g⟩

end OTSelector.Geometry.ContinuousFinslerNorm.IsSmoothStronglyConvex

end
end
