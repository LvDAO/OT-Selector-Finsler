/-! Original source unit: `OTSelector.Reconstruction.StationaryFaceBoxMeanErgodic`; the selected original proof blocks follow. -/
section

/-!
Conditions: A family of Hilbert isometries and actual contraction operators annihilating every translation coboundary along the stated filter.

Objects: Orthogonal complement/closure identities for the coboundary span and convergence to zero on the complement of global invariants.

Proof detail: Identify the orthogonal complement by the isometry pairing, apply double orthogonal closure and extend convergence from the dense coboundary span using the uniform contraction norm.

Sources: Terence Tao, Section 1.4, Exercises 1.4.12–1.4.13, pp. 52–53 (https://terrytao.wordpress.com/wp-content/uploads/2012/12/gsm-117-tao3-epsilon1.pdf#page=61); Terence Tao, Section 1.4, Lemma 1.4.7 (Cauchy–Schwarz inequality), p. 48 (https://terrytao.wordpress.com/wp-content/uploads/2012/12/gsm-117-tao3-epsilon1.pdf#page=57).
Relation: Hilbert closure/density argument. The general contraction family need not be literal time averages, so this is not claimed as a verbatim classical mean-ergodic theorem.
-/

/-! Genuine Hilbert-space spatial box averages and their mean-ergodic limit. -/

open Set Function Filter Submodule MeasureTheory
open scoped InnerProductSpace Topology BigOperators
noncomputable section
namespace OTSelector.Probability

variable {F H : Type*} [AddCommGroup F] [Module ℝ F]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The linear space generated by actual translation differences. -/
def translationCoboundarySpan (U : F → H ≃ₗᵢ[ℝ] H) : Submodule ℝ H :=
  Submodule.span ℝ (Set.range (fun p : F × H ↦ U p.1 p.2 - p.2))

omit [CompleteSpace H] in
/-- Orthogonality to every genuine translation difference is exactly
invariance under every translation. -/
theorem orthogonal_translationCoboundarySpan
    (U : F → H ≃ₗᵢ[ℝ] H) :
    (translationCoboundarySpan U)ᗮ = translationFixedSubspace U ⊤ := by
  ext x
  constructor
  · intro hx a _
    have h := hx (U a x - x) (Submodule.subset_span ⟨(a, x), rfl⟩)
    rw [inner_sub_left, real_inner_self_eq_norm_sq] at h
    apply eq_of_norm_le_re_inner_eq_norm_sq (𝕜 := ℝ) ((U a).norm_map x).le
    simpa only [RCLike.re_to_real] using sub_eq_zero.1 h
  · intro hx
    have hsub : translationCoboundarySpan U ≤ (ℝ ∙ x)ᗮ := by
      apply Submodule.span_le.2
      rintro y ⟨⟨a, z⟩, rfl⟩
      change U a z - z ∈ (ℝ ∙ x)ᗮ
      apply Submodule.mem_orthogonal_singleton_iff_inner_left.2
      rw [inner_sub_left]
      have hfixed := hx a (by trivial)
      have he : ⟪U a z, x⟫_ℝ = ⟪z, x⟫_ℝ := by
        calc
          _ = ⟪U a z, U a x⟫_ℝ := by rw [hfixed]
          _ = _ := (U a).inner_map_map z x
      exact sub_eq_zero.2 he
    intro y hy
    exact Submodule.mem_orthogonal_singleton_iff_inner_left.1 (hsub hy)

/-- The closure of actual translation differences is the orthogonal
complement of the full joint invariant subspace. -/
theorem closure_translationCoboundarySpan
    (U : F → H ≃ₗᵢ[ℝ] H) :
    (translationCoboundarySpan U).topologicalClosure =
      (translationFixedSubspace U ⊤)ᗮ := by
  rw [← Submodule.orthogonal_orthogonal_eq_closure, orthogonal_translationCoboundarySpan]

/-- Uniform contractions that annihilate every actual translation
difference annihilate the full orthogonal complement of joint invariants.
This is the dense Hilbert extension step used after the concrete box-shell
estimate has established the coboundary limits. -/
theorem tendsto_contractions_zero_of_translation_coboundaries
    {J : Type*} (l : Filter J) (U : F → H ≃ₗᵢ[ℝ] H)
    (A : J → H →L[ℝ] H) (hA : ∀ j, ‖A j‖ ≤ 1)
    (hcob : ∀ a y, Tendsto (fun j ↦ A j (U a y - y)) l (𝓝 0))
    {x : H} (hx : x ∈ (translationFixedSubspace U ⊤)ᗮ) :
    Tendsto (fun j ↦ A j x) l (𝓝 0) := by
  let Z : Submodule ℝ H :=
    { carrier := {x | Tendsto (fun j ↦ A j x) l (𝓝 0)}
      zero_mem' := by
        change Tendsto (fun j ↦ A j 0) l (𝓝 0)
        simpa only [map_zero] using
          (tendsto_const_nhds : Tendsto (fun _ : J ↦ (0 : H)) l (𝓝 0))
      add_mem' := by
        intro x y hx hy
        change Tendsto (fun j ↦ A j (x + y)) l (𝓝 0)
        simpa only [map_add, zero_add] using hx.add hy
      smul_mem' := by
        intro c x hx
        change Tendsto (fun j ↦ A j (c • x)) l (𝓝 0)
        simpa only [map_smul, smul_zero] using hx.const_smul c }
  have hequi : Equicontinuous (fun j x ↦ A j x) := by
    apply Metric.equicontinuous_of_continuity_modulus id tendsto_id
    intro x y j
    change dist (A j x) (A j y) ≤ dist x y
    rw [dist_eq_norm, ← map_sub, dist_eq_norm]
    simpa only [one_mul] using (A j).le_of_opNorm_le (hA j) (x - y)
  have hclosed : IsClosed (Z : Set H) :=
    hequi.isClosed_setOfPred_tendsto continuous_const
  have hspan : translationCoboundarySpan U ≤ Z := by
    apply Submodule.span_le.2
    rintro y ⟨⟨a, z⟩, rfl⟩
    exact hcob a z
  have hclosure := (translationCoboundarySpan U).topologicalClosure_minimal hspan hclosed
  rw [closure_translationCoboundarySpan] at hclosure
  exact hclosure hx

omit [CompleteSpace H] in
/-- Coordinates of a spatial face identify its joint invariants with those
of the original translations in the ACTUAL range of the coordinate map. -/
theorem translationFixedSubspace_comp_linearMap
    {ι : Type*} (U : F → H ≃ₗᵢ[ℝ] H) (L : (ι → ℝ) →ₗ[ℝ] F) :
    translationFixedSubspace (fun v ↦ U (L v)) ⊤ =
      translationFixedSubspace U L.range := by
  ext x
  constructor
  · intro hx a ha
    obtain ⟨v, rfl⟩ := ha
    exact hx v (by trivial)
  · intro hx v _
    exact hx (L v) ⟨v, rfl⟩



end OTSelector.Probability



