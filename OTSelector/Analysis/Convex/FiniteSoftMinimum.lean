import Mathlib.Analysis.Calculus.FDeriv.Add
import Mathlib.Analysis.Calculus.FDeriv.Mul
import Mathlib.Analysis.SpecialFunctions.ExpDeriv
import Mathlib.Analysis.SpecialFunctions.Log.Deriv

/-!
## Lemma skeleton

* **Conditions:** A finite nonempty family; nonzero smoothing parameter for the derivative formulas.
* **Objects:** The negative scaled log-sum-exp and normalized exponential weights.
* **Proof detail:** Differentiate exp, finite sum and log; regroup into the weighted derivatives.

## Mathematical sources

* Stephen Boyd; Lieven Vandenberghe, *Convex Optimization (2004)*, Section 3.1.5, pp. 72–74, log-sum-exp example and derivative calculation.
  https://web.stanford.edu/~boyd/cvxbook/bv_cvxbook.pdf#page=86
* Jiří Lebl, *Basic Analysis II: Introduction to Real Analysis, Volume II*, Sections 8.3–8.4, total derivative, chain rule and mean-value bounds; Section 8.6, higher derivatives.
  https://www.jirka.org/ra/realanal2.pdf

**Relationship to the sources:** The normalized finite type and Banach-domain Fréchet derivative are explicit chain-rule adaptations of log-sum-exp.
-/

/-!
# Finite smooth minimum and its genuine derivative

The normalized exponential weights below are generated by the same finite
potential values. They are positive and sum to one; the actual derivative of
the smooth minimum is their weighted sum of the original derivatives.
-/
open Finset
open scoped BigOperators
noncomputable section
namespace OTSelector.Reconstruction
set_option maxHeartbeats 1800000

variable {I : Type*} [Fintype I] [Nonempty I]

/-- Smooth approximation from below to the minimum of the original finite values. -/
def finiteSoftMinimum (ε : ℝ) (a : I → ℝ) : ℝ :=
  -ε * Real.log (∑ i, Real.exp (-ε⁻¹ * a i))

/-- The actual normalized exponential weights of the same smooth minimum. -/
def finiteSoftMinimumWeight (ε : ℝ) (a : I → ℝ) (i : I) : ℝ :=
  Real.exp (-ε⁻¹ * a i) / ∑ j, Real.exp (-ε⁻¹ * a j)

theorem finiteSoftMinimum_sum_exp_pos (ε : ℝ) (a : I → ℝ) :
    0 < ∑ i, Real.exp (-ε⁻¹ * a i) :=
  Finset.sum_pos (fun _ _ ↦ Real.exp_pos _) Finset.univ_nonempty

theorem finiteSoftMinimumWeight_pos (ε : ℝ) (a : I → ℝ) (i : I) :
    0 < finiteSoftMinimumWeight ε a i :=
  div_pos (Real.exp_pos _) (finiteSoftMinimum_sum_exp_pos ε a)

theorem sum_finiteSoftMinimumWeight (ε : ℝ) (a : I → ℝ) :
    ∑ i, finiteSoftMinimumWeight ε a i = 1 := by
  dsimp only [finiteSoftMinimumWeight]
  simp only [div_eq_mul_inv, ← Finset.sum_mul]
  exact mul_inv_cancel₀ (finiteSoftMinimum_sum_exp_pos ε a).ne'

/-- This is the actual Fréchet derivative, with weights internally computed
from the same original function values at the same point. -/
theorem hasFDerivAt_finiteSoftMinimum
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ε : ℝ) (hε : ε ≠ 0) (F : I → E → ℝ) (F' : I → E →L[ℝ] ℝ) (x : E)
    (hF : ∀ i, HasFDerivAt (F i) (F' i) x) :
    HasFDerivAt (fun y ↦ finiteSoftMinimum ε (fun i ↦ F i y))
      (∑ i, finiteSoftMinimumWeight ε (fun j ↦ F j x) i • F' i) x := by
  have hsum : HasFDerivAt (fun y ↦ ∑ i, Real.exp (-ε⁻¹ * F i y))
      (∑ i, Real.exp (-ε⁻¹ * F i x) • ((-ε⁻¹) • F' i)) x :=
    HasFDerivAt.fun_sum fun i _ ↦ ((hF i).const_smul (-ε⁻¹)).exp
  have hlog := (hsum.log (finiteSoftMinimum_sum_exp_pos ε (fun i ↦ F i x)).ne').const_smul (-ε)
  apply hlog.congr_fderiv
  ext y
  simp only [smul_apply, _root_.sum_apply, smul_eq_mul]
  rw [Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  dsimp only [finiteSoftMinimumWeight]
  field_simp

/-- The same genuine chain rule for one real interpolation-time variable. -/
theorem hasDerivAt_finiteSoftMinimum
    (ε : ℝ) (hε : ε ≠ 0) (F : I → ℝ → ℝ) (F' : I → ℝ) (τ : ℝ)
    (hF : ∀ i, HasDerivAt (F i) (F' i) τ) :
    HasDerivAt (fun σ ↦ finiteSoftMinimum ε (fun i ↦ F i σ))
      (∑ i, finiteSoftMinimumWeight ε (fun j ↦ F j τ) i * F' i) τ := by
  have h := hasFDerivAt_finiteSoftMinimum ε hε F
    (fun i ↦ (1 : ℝ →L[ℝ] ℝ).smulRight (F' i)) τ (fun i ↦ (hF i).hasFDerivAt)
  simpa using h.hasDerivAt

end OTSelector.Reconstruction
