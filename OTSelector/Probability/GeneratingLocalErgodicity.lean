import Mathlib.Dynamics.Ergodic.Ergodic
import Mathlib.MeasureTheory.Measure.MeasuredSets
import Mathlib.MeasureTheory.Measure.Real
import Mathlib.Probability.Independence.Basic

/-!
# Generating Local Ergodicity

Conditions: An increasing local sigma-family generating the ambient sigma-algebra, a probability-preserving transformation and, for every local event, one iterate independent of that event.

Objects: Approximation of each ambient event by a local event and ergodicity of the actual transformation.

Proof detail: Use finite-measure event approximation for the increasing generated sigma-family. Approximate an invariant event, apply the supplied local independent iterate and let the symmetric-difference error vanish to obtain p=p².

Relation to primary sources: A local-observation ergodicity criterion motivated by the standard separated-local-events argument; neither complete mixing nor a point-process model is required.

References:
* Gunter Last; Mathew Penrose, Lectures on the Poisson Process, author version 21 August 2017, Section 8.4, invariant field (8.13), Proposition 8.12 and Proposition 8.13, pp. 75–76. https://stoch.math.kit.edu/img/Last/lastpenrose2017.pdf#page=87
* Rick Durrett, Probability: Theory and Examples, fifth edition, author version 11 January 2019, Section 6.1, Example 6.1.4 and invariant-event/ergodicity definitions, pp. 331–332; Exercises 6.1.1–6.1.2, p. 334. https://sites.math.duke.edu/~rtd/PTE/PTE5_011119.pdf#page=340
-/
/-!
# Ergodicity from independent translated local observations

An increasing family of local sigma algebras generating the whole measurable space permits
finite-window approximation of all events.  The resulting ergodicity criterion only asks for
independence of a local event and one of its iterated translates.
-/

open Set Function Filter MeasureTheory MeasureTheory.Measure ProbabilityTheory
open scoped ENNReal symmDiff

namespace OTSelector.Probability

/-- An event in the sigma algebra generated by increasing local observations is approximable,
in symmetric-difference mass, by a single finite observation. -/
theorem exists_local_event_measure_symmDiff_lt {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsFiniteMeasure P] (ℱ : ℕ → MeasurableSpace Ω)
    (hmono : Monotone ℱ) (hsup : (⨆ n, ℱ n) = mΩ)
    {A : Set Ω} (hA : MeasurableSet A) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ n B, MeasurableSet[ℱ n] B ∧ P (B ∆ A) < ε := by
  let C : Set (Set Ω) := {B | ∃ n, MeasurableSet[ℱ n] B}
  have hC : IsSetRing C := by
    refine ⟨⟨0, @MeasurableSet.empty Ω (ℱ 0)⟩, ?_, ?_⟩
    · rintro B D ⟨n, hn⟩ ⟨k, hk⟩
      exact ⟨max n k, (hmono (Nat.le_max_left n k) _ hn).union
        (hmono (Nat.le_max_right n k) _ hk)⟩
    · rintro B D ⟨n, hn⟩ ⟨k, hk⟩
      exact ⟨max n k, (hmono (Nat.le_max_left n k) _ hn).diff
        (hmono (Nat.le_max_right n k) _ hk)⟩
  have hgen : mΩ = MeasurableSpace.generateFrom C := by
    rw [← hsup]
    apply le_antisymm
    · refine iSup_le fun n B hB ↦ ?_
      exact MeasurableSpace.measurableSet_generateFrom ⟨n, hB⟩
    · refine MeasurableSpace.generateFrom_le ?_
      rintro B ⟨n, hn⟩
      exact (le_iSup ℱ n) B hn
  obtain ⟨B, ⟨n, hn⟩, hB⟩ :=
    exists_measure_symmDiff_lt_of_generateFrom_isSetRing (μ := P) hC
      ⟨{univ}, Set.countable_singleton _, by
        rintro B (rfl : B = univ)
        exact ⟨0, @MeasurableSet.univ Ω (ℱ 0)⟩, by simp⟩ hgen hA hε
  exact ⟨n, B, hn, hB⟩

/-- Local self-independence after translation, together with generation by local observations,
forces every invariant event to be trivial. -/
theorem ergodic_of_generating_local_independence {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (T : Ω → Ω)
    (hT : MeasurePreserving T P P) (ℱ : ℕ → MeasurableSpace Ω)
    (hmono : Monotone ℱ) (hsup : (⨆ n, ℱ n) = mΩ)
    (hind : ∀ n B, MeasurableSet[ℱ n] B →
      ∃ k : ℕ, IndepSet B (T^[k] ⁻¹' B) P) : Ergodic T P := by
  refine ⟨hT, ⟨?_⟩⟩
  intro A hA hTA
  have hAiter (k : ℕ) : T^[k] ⁻¹' A = A := by
    rw [Set.preimage_iterate_eq]
    exact Function.iterate_fixed hTA k
  have happrox (ε : ℝ) (hε : 0 < ε) : |P.real A - (P.real A) ^ 2| < 4 * ε := by
    obtain ⟨n, B, hBn, hBA⟩ := exists_local_event_measure_symmDiff_lt P ℱ hmono hsup
      hA (ENNReal.ofReal_pos.mpr hε)
    have hB : MeasurableSet B := (hsup ▸ le_iSup ℱ n) B hBn
    have hBAreal : P.real (B ∆ A) < ε := ENNReal.toReal_lt_of_lt_ofReal hBA
    obtain ⟨k, hindk⟩ := hind n B hBn
    let C := T^[k] ⁻¹' B
    have hC : MeasurableSet C := (hT.iterate k).measurable hB
    have hCA : P.real (C ∆ A) = P.real (B ∆ A) := by
      have heq : C ∆ A = T^[k] ⁻¹' (B ∆ A) := by
        rw [Set.preimage_symmDiff, hAiter k]
      rw [heq]
      exact (hT.iterate k).measureReal_preimage (hB.symmDiff hA).nullMeasurableSet
    have hCB : P.real C = P.real B :=
      (hT.iterate k).measureReal_preimage hB.nullMeasurableSet
    have hBC : P.real (B ∩ C) = (P.real B) ^ 2 := by
      change (P (B ∩ C)).toReal = _
      rw [hindk.measure_inter_eq_mul, ENNReal.toReal_mul]
      change P.real B * P.real C = _
      rw [hCB, pow_two]
    have hsubset : A ∆ (B ∩ C) ⊆ (B ∆ A) ∪ (C ∆ A) := by
      intro x hx
      simp only [Set.mem_symmDiff, Set.mem_inter_iff, Set.mem_union] at hx ⊢
      tauto
    have hAI : |P.real A - P.real (B ∩ C)| ≤
        P.real (B ∆ A) + P.real (C ∆ A) :=
      (abs_measureReal_sub_le_measureReal_symmDiff hA.nullMeasurableSet
        (hB.inter hC).nullMeasurableSet).trans
        ((measureReal_mono hsubset).trans (measureReal_union_le _ _))
    have hAB : |P.real B - P.real A| < ε :=
      (abs_measureReal_sub_le_measureReal_symmDiff hB.nullMeasurableSet
        hA.nullMeasurableSet).trans_lt hBAreal
    have ha0 : 0 ≤ P.real A := measureReal_nonneg
    have hb0 : 0 ≤ P.real B := measureReal_nonneg
    have ha1 : P.real A ≤ 1 := measureReal_le_one
    have hb1 : P.real B ≤ 1 := measureReal_le_one
    have hsquare : |(P.real B) ^ 2 - (P.real A) ^ 2| < 2 * ε := by
      rcases le_total (P.real A) (P.real B) with h | h
      · rw [abs_of_nonneg (sub_nonneg.mpr (pow_le_pow_left₀ ha0 h 2))]
        rw [abs_of_nonneg (sub_nonneg.mpr h)] at hAB
        nlinarith
      · rw [abs_of_nonpos (sub_nonpos.mpr (pow_le_pow_left₀ hb0 h 2))]
        rw [abs_of_nonpos (sub_nonpos.mpr h)] at hAB
        nlinarith
    calc
      |P.real A - (P.real A) ^ 2| ≤
          |P.real A - (P.real B) ^ 2| + |(P.real B) ^ 2 - (P.real A) ^ 2| :=
        abs_sub_le _ _ _
      _ < 4 * ε := by rw [hBC] at hAI; rw [hCA] at hAI; linarith
  have hfixed : P.real A = (P.real A) ^ 2 := by
    by_contra hne
    have hpos : 0 < |P.real A - (P.real A) ^ 2| := abs_pos.mpr (sub_ne_zero.mpr hne)
    have := happrox (|P.real A - (P.real A) ^ 2| / 8) (by positivity)
    linarith
  have hzeroone : P.real A = 0 ∨ P.real A = 1 := by
    have : P.real A * (P.real A - 1) = 0 := by nlinarith [hfixed]
    rcases mul_eq_zero.mp this with h | h
    · exact Or.inl h
    · exact Or.inr (sub_eq_zero.mp h)
  apply eventuallyConst_set'.mpr
  rcases hzeroone with hzero | hone
  · exact Or.inl (ae_eq_empty.mpr ((measureReal_eq_zero_iff).mp hzero))
  · apply Or.inr
    apply (ae_eq_univ_iff_measure_eq hA.nullMeasurableSet).mpr
    rw [measure_univ, ← ENNReal.toReal_eq_one_iff]
    exact hone

end OTSelector.Probability
